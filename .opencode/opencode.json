{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-terminal-bell-notifier",
    ".opencode/plugins/graphify.js"
  ],
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        ".venv/bin/python3",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "enabled": true
    }
  }
}
